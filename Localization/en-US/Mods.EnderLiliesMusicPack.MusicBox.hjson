TheSunOutroMusicBox: {
	DisplayName: 音乐盒(The Sun - Outro)
	Tooltip:
		'''
		播放 [c/FFFAFA:The Sun - Outro](2:40)
		深渊守卫 - 海尼尔的匕首
		'''
}

BulbelMusicBox: {
	DisplayName: 音乐盒(Bulbel)
	Tooltip:
		'''
		播放 [c/FFFAFA:Bulbel](3:26)
		我倾注了我的一切，不该换来一缕阳光吗？
		但我的雨下不停，我的雨下不停
		我所看见的地狱，所听见的悲鸣
		所失去的憧憬，什么也改变不了
		我仍是那个我无法忍受的自己
		点燃青丝，给予你温暖
		希望你知道，我希望你在我身边
		愿百合花为我盛开

		本以为我会感到欣慰，看着在彼岸感到满足的你
		但不知为何，我不切实际地幻想着：
		我值得被爱
		我有资格知道什么是爱
		我们都应该浸润在爱当中
		多么希望没有尽头，多么渴望没有落幕
		我们在一起的时光
		百合花们凋零了
		撒向我的灵柩
		再见，我的青春挥霍殆尽，再见，我的纯白无暇
		我该歇斯底里吗？我该欣然接受吗？我满足了吗？
		我该怎样做才能让我为自己感到自豪？
		即便实现目标，无视我的情感，一切如故
		我依然是那个贪得无厌的自己
		当个傻瓜不是更好吗？一直一无所知？
		比起认识到世上有与我无缘的自由
		[c/FFFAFA:愿百合花为我盛开]
		'''
}

